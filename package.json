{
  "name": "@mitralab.io/functions-sdk",
  "version": "0.2.0-beta.0",
  "description": "JavaScript and TypeScript SDK for Mitra Server Functions",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "contracts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:declarations": "node scripts/check-declarations.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:contracts": "node scripts/check-contract-corpus.mjs",
    "check:contracts:source": "node scripts/check-contract-corpus.mjs --canonical-source",
    "pack:check": "npm pack --dry-run",
    "smoke:package": "node scripts/smoke-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run check:declarations && npm run check:exports && npm run check:contracts && npm run pack:check && npm run smoke:package",
    "prepublishOnly": "npm run check && npm run check:contracts:source"
  },
  "keywords": [
    "mitra",
    "sdk",
    "serverless",
    "functions"
  ],
  "author": "Mitra Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitralab-dev/mitra-functions-sdk-js"
  },
  "homepage": "https://github.com/mitralab-dev/mitra-functions-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/mitralab-dev/mitra-functions-sdk-js/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@mitralab.io/sdk-core": "0.2.0-beta.0",
    "mitra-sdk": "1.0.63-beta.39"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "globals": "^17.11.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.67.0",
    "vite": "~6.4.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "test-exclude": "7.0.1"
  }
}
